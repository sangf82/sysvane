{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-monitor.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Checking monitor safety"
          }
        ]
      }
    ]
  }
}
